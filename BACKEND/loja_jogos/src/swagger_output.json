{
  "swagger": "2.0",
  "info": {
    "title": "loja-jogos-api",
    "version": "1.0.0",
    "description": "API de Loja de Jogos para exercício de Swagger"
  },
  "host": "localhost:3001",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "paths": {
    "/jogos/": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Dados do novo jogo ",
            "schema": {
              "type": "object",
              "properties": {
                "nome": {
                  "type": "string",
                  "example": "Construa sua casa - SIMULAÇÃO"
                },
                "desenvolvedora": {
                  "type": "string",
                  "example": "Ana C."
                },
                "preco": {
                  "type": "number",
                  "example": 190
                },
                "anoLancamento": {
                  "type": "number",
                  "example": 2026
                }
              },
              "required": [
                "nome",
                "desenvolvedora",
                "preco",
                "anoLancamento"
              ]
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/jogos/{id}": {
      "get": {
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "put": {
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Dados para atualizar o livro (envie apenas os que deseja alterar)",
            "schema": {
              "type": "object",
              "properties": {
                "titulo": {
                  "type": "string",
                  "example": "Construa sua casa - SIMULAÇÃO"
                },
                "autor": {
                  "type": "string",
                  "example": "Ana C."
                },
                "preco": {
                  "type": "number",
                  "example": 170
                },
                "anoLancamento": {
                  "type": "number",
                  "example": 2026
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "delete": {
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  }
}